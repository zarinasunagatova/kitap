<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20" styleClass="culture-root" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.tatar.learn.controllers.CultureController">
    
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    
    <!-- Заголовок -->
    <VBox alignment="CENTER" spacing="10">
        <Label styleClass="culture-title" text="🎨 Татарская культура" />
        <Label styleClass="culture-subtitle" text="Татар мәдәнияте" />
    </VBox>
    
    <Separator styleClass="culture-separator" />
    
    <!-- Фильтр по категориям -->
    <HBox alignment="CENTER" spacing="15">
        <Label styleClass="filter-label" text="📂 Категория:" />
        <ComboBox fx:id="categoryCombo" styleClass="culture-combo" prefWidth="200" />
    </HBox>
    
    <Separator styleClass="culture-separator-light" />
    
    <!-- Сетка с карточками (с прокруткой) -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="culture-scroll">
        <GridPane fx:id="itemsGrid" hgap="25" vgap="25" alignment="CENTER">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>
        </GridPane>
    </ScrollPane>
    
    <!-- Детальный вид - на весь экран -->
    <VBox fx:id="detailView" spacing="10" visible="false" managed="false" 
          styleClass="culture-detail-fullscreen" VBox.vgrow="ALWAYS">
        
        <Button fx:id="backButton" styleClass="culture-back-button" text="← Назад к списку" />
        
        <!-- Компактный заголовок -->
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="detail-header">
            <Label fx:id="detailIcon" styleClass="detail-icon" />
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label fx:id="detailTitle" styleClass="detail-title" />
                <Label fx:id="detailTitleTatar" styleClass="detail-title-tatar" />
            </VBox>
        </HBox>
        
        <Separator styleClass="culture-separator" />
        
        <!-- Текст на всю оставшуюся площадь -->
        <VBox spacing="10" VBox.vgrow="ALWAYS">
            <Label styleClass="detail-section-title" text="📖 Описание / Тасвирлама" />
            
            <TextArea fx:id="detailDescription" styleClass="detail-text-area" 
                      wrapText="true" editable="false" VBox.vgrow="ALWAYS" />
            
            <Label styleClass="detail-section-title" text="📖 Татарча / На татарском" />
            
            <TextArea fx:id="detailDescriptionTatar" styleClass="detail-text-area-tatar" 
                      wrapText="true" editable="false" VBox.vgrow="ALWAYS" />
        </VBox>
        
    </VBox>
    
</VBox>