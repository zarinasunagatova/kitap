<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="399.0" prefWidth="522.0" spacing="20" styleClass="culture-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tatar.learn.controllers.CultureController">
    
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    
    <!-- Заголовок -->
    <VBox alignment="CENTER" spacing="10">
        <Label styleClass="culture-title" text="🎨 Татарская культура" />
        <Label styleClass="culture-subtitle" text="Татар мәдәнияте" />
    </VBox>
    
    <Separator styleClass="culture-separator" />
    
    <!-- Фильтр по категориям -->
    <HBox alignment="CENTER" spacing="15">
        <Label styleClass="filter-label" text="📂 Категория:" />
        <ComboBox fx:id="categoryCombo" prefWidth="200" styleClass="culture-combo" />
    </HBox>
    
    <Separator styleClass="culture-separator-light" />
    
    <!-- Сетка с карточками (с прокруткой) -->
    <ScrollPane fitToWidth="true" prefHeight="202.0" prefWidth="501.0" styleClass="culture-scroll" VBox.vgrow="ALWAYS">
        <GridPane fx:id="itemsGrid" alignment="CENTER" hgap="25" vgap="25">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>
        </GridPane>
    </ScrollPane>
    
    <!-- Детальный вид -->
    <VBox fx:id="detailView" managed="false" spacing="20" styleClass="culture-detail" visible="false">
        
        <Button fx:id="backButton" styleClass="culture-back-button" text="← Назад к списку" />
        
        <VBox alignment="CENTER" spacing="10">
            <Label fx:id="detailIcon" styleClass="detail-icon" />
            <Label fx:id="detailTitle" styleClass="detail-title" />
            <Label fx:id="detailTitleTatar" styleClass="detail-title-tatar" />
        </VBox>
        
        <Separator styleClass="culture-separator" />
        
        <VBox spacing="15" VBox.vgrow="ALWAYS">
		    <Label styleClass="detail-section-title" text="📖 Описание / Тасвирлама" />
		    
		    <TextArea fx:id="detailDescription" styleClass="detail-text-area" wrapText="true" editable="false" 
		              VBox.vgrow="ALWAYS" prefRowCount="4" />
		    
		    <TextArea fx:id="detailDescriptionTatar" styleClass="detail-text-area-tatar" wrapText="true" editable="false" 
		              VBox.vgrow="ALWAYS" prefRowCount="4" />
		</VBox>
		        
        <VBox fx:id="funFactsBox" spacing="10" visible="false">
            <Label styleClass="detail-section-title" text="✨ Интересные факты / Кызыклы фактлар" />
            <VBox fx:id="funFactsList" spacing="8" />
        </VBox>
        
    </VBox>
    
</VBox>
