<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700" prefWidth="1100" spacing="10" styleClass="root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="com.tatar.learn.controllers.DictionaryController">
    
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    
    <!-- Заголовок -->
    <Label styleClass="main-title" text="Сүзлек / Словарь" />
    
    <Separator />
    
    <!-- Панель поиска -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="search-label" text="Поиск:" />
        <TextField fx:id="searchField" prefHeight="35" promptText="Введите слово на татарском или русском..." HBox.hgrow="ALWAYS" />
        <Button fx:id="searchButton" prefHeight="26.0" prefWidth="105.0" styleClass="action-button" text="Найти" />
        <Button fx:id="clearButton" prefHeight="26.0" prefWidth="105.0" styleClass="action-button" text="Сбросить" />
    </HBox>
    
    <!-- Кнопки добавления и импорта -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="addButton" prefHeight="26.0" prefWidth="205.0" styleClass="action-button" text="➕ Добавить слово" />
    </HBox>
    
    <!-- Таблица со словами -->
    <TableView fx:id="wordsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" maxWidth="60" minWidth="50" text="ID" />
            <TableColumn fx:id="tatarColumn" minWidth="150" prefWidth="200" text="Татарча" />
            <TableColumn fx:id="russianColumn" minWidth="150" prefWidth="200" text="Русский" />
            <TableColumn fx:id="examplesColumn" minWidth="100" prefWidth="150" text="Примеры" />
            <TableColumn fx:id="timesCorrectColumn" maxWidth="120" minWidth="100" text="Правильно" />
            <TableColumn fx:id="actionsColumn" maxWidth="300" minWidth="250" text="Действия" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
    
    <!-- Статус бар -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="statusLabel" styleClass="status-label" text="Готово" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="countLabel" styleClass="progress-label" text="Всего слов: 0" />
    </HBox>
</VBox>